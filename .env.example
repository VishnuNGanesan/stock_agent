# Copy this file to .env and fill in your values:  cp .env.example .env

# --- Claude API (https://console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=sk-ant-...

# --- Gmail. Needs 2-Step Verification + an App Password:
#     https://myaccount.google.com/apppasswords
EMAIL_SENDER=you@gmail.com
EMAIL_APP_PASSWORD=abcd efgh ijkl mnop
EMAIL_RECIPIENT=you@gmail.com

# --- Stocks you own (always analysed, comma separated NSE symbols)
MY_HOLDINGS=

# --- Optional tuning
# ANTHROPIC_MODEL=claude-opus-5-5
# AGENT_EFFORT=medium          # low | medium | high | xhigh | max
# TOP_N_TO_RESEARCH=8          # top-scored stocks sent to the agents each day
# MAX_BIG_MOVERS=3
# AGENT_WORKERS=3              # stocks researched in parallel
# RUN_AFTER_IST=18:30
